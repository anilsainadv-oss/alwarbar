# ==============================================================================
# ALWAR ADVOCATES PORTAL & MY CASE AI LEGAL OFFICE — PRODUCTION ENVIRONMENT TEMPLATE
# ==============================================================================
# Copy this file to .env.local for local development, or set these variables
# in your production environment (Vercel, Docker, AWS, or Linux VPS).
# NEVER commit real production credentials or private keys to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION & DOMAIN
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="Alwar Advocates Portal"
# Canonical application URL with protocol scheme (e.g. 'https://alwarbar.mangallaxmi.com' or 'http://localhost:3000')
NEXT_PUBLIC_APP_URL="https://alwarbar.mangallaxmi.com"
NEXT_PUBLIC_SITE_LOCALE="hi" # 'hi' (Hindi default) or 'en' (English)
NODE_ENV="production"

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & CRYPTOGRAPHIC SESSION TOKENS
# ------------------------------------------------------------------------------
# Minimum 32-character high-entropy secret for HMAC-SHA256 session token signatures
AUTH_SECRET="generate-a-strong-random-64-character-hex-string-for-production"
SESSION_COOKIE_NAME="alwar_law_session"
SESSION_MAX_AGE_DAYS=7

# Bootstrap Token: Used only once to claim initial super-admin credentials.
# Leave blank or set to a complex one-time secret that you immediately invalidate.
ADMIN_BOOTSTRAP_TOKEN="generate-a-one-time-bootstrap-token"

# ------------------------------------------------------------------------------
# 3. DATABASE & PERSISTENCE (MANAGED POSTGRESQL / SUPABASE)
# ------------------------------------------------------------------------------
# Leave blank to operate on ACID-compliant local JSON/SQLite persistence.
# For production PostgreSQL / Supabase, provide the project coordinates:
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"
# SUPABASE_SERVICE_ROLE_KEY is strictly server-only. NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key-never-expose-to-browser"

# ------------------------------------------------------------------------------
# 4. CONFIDENTIAL DOCUMENT VAULT & CLOUDFLARE R2 OBJECT STORAGE
# ------------------------------------------------------------------------------
# Cloud storage bucket names for encrypted legal pleadings and case evidence
STORAGE_BUCKET_PUBLIC_DOCUMENTS="public-court-documents"
STORAGE_BUCKET_PRIVATE_CASES="private-advocate-cases"
MAX_UPLOAD_SIZE_MB=25

# Cloudflare R2 Object Storage Credentials (S3-Compatible Private Bucket for Original Judgment PDFs)
# Obtain these from: Cloudflare Dashboard -> R2 Object Storage -> Manage R2 API Tokens
CLOUDFLARE_ACCOUNT_ID="your-cloudflare-account-id"
CLOUDFLARE_R2_ACCESS_KEY_ID="your-r2-access-key-id"
CLOUDFLARE_R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
CLOUDFLARE_R2_BUCKET_NAME="alwar-court-judgments"

# ------------------------------------------------------------------------------
# 5. AI LEGAL ASSISTANT ENGINE (OPTIONAL / MODULAR)
# ------------------------------------------------------------------------------
# Available providers: "demo" (honest offline deterministic analysis), "gemini", "openai", "groq"
# If AI_API_KEY is empty, system automatically operates in honest deterministic demo mode (INR 0.00 cost).
AI_PROVIDER="demo"
AI_MODEL_NAME="gemini-1.5-flash"
AI_API_KEY=""
AI_MAX_TOKENS=4000
AI_TEMPERATURE=0.2
AI_RATE_LIMIT_PER_MINUTE=15

# ------------------------------------------------------------------------------
# 6. SAAS PAYMENTS & BILLING (RAZORPAY INDIA)
# ------------------------------------------------------------------------------
# Test mode keys start with "rzp_test_". Production keys start with "rzp_live_".
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret_for_hmac_verification"

# ------------------------------------------------------------------------------
# 7. AUTOMATION & NOTIFICATIONS (EMAIL & WHATSAPP)
# ------------------------------------------------------------------------------
# Email Service: "simulator" (default offline logging) or "resend" or "smtp"
EMAIL_PROVIDER="simulator"
RESEND_API_KEY=""
EMAIL_FROM="District Bar Alwar <notifications@alwaradvocates.org>"

# WhatsApp Business API: "simulator" (default offline simulator) or "meta_cloud"
WHATSAPP_PROVIDER="simulator"
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""

# ------------------------------------------------------------------------------
# 8. RATE LIMITING & SECURITY CONTROLS
# ------------------------------------------------------------------------------
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_SEC=900
RATE_LIMIT_API_MAX=60
RATE_LIMIT_API_WINDOW_SEC=60

# ------------------------------------------------------------------------------
# 9. AI LEGAL RESEARCH & PGVECTOR HYBRID SEARCH ENGINE (CASE LAW RAG)
# ------------------------------------------------------------------------------
# Embeddings: OpenAI text-embedding-3-small (1536-dim) or compatible model.
# If OPENAI_API_KEY is left empty, system automatically operates with zero external cost
# using deterministic unit-normalized 1536-dim vector mathematics.
OPENAI_API_KEY=""
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
LEGAL_RESEARCH_RAG_PROVIDER="offline" # 'offline' | 'openai' | 'gemini'
PGVECTOR_SIMILARITY_THRESHOLD="0.40"
PGVECTOR_MAX_SEARCH_CHUNKS="20"
