# ==============================================================================
# ALWAR ADVOCATES PORTAL & MY CASE AI LEGAL OFFICE — ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env.local for development.
# Never commit real credentials, service-role keys, or secrets to version control.

# Application Base
NEXT_PUBLIC_APP_NAME="Alwar Advocates Portal"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_LOCALE="hi" # 'hi' (Hindi) or 'en' (English)

# Database & Supabase (Free-First Managed PostgreSQL)
# Leave blank to use built-in local filesystem/storage database engine for immediate offline testing
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-do-not-expose-to-browser"

# Authentication & Session Secrets
AUTH_SECRET="alwar-advocates-secure-development-secret-change-in-production-min-32-chars"
SESSION_COOKIE_NAME="alwar_law_session"

# AI Legal Assistant Configuration (Provider Independent)
# Available providers: "demo" (default honest fallback), "gemini", "openai", "groq", "local"
AI_PROVIDER="demo"
AI_MODEL_NAME="gemini-1.5-flash"
AI_API_KEY=""
AI_MAX_TOKENS=4000
AI_TEMPERATURE=0.2

# Document Storage Bucket Configuration
STORAGE_BUCKET_PUBLIC_DOCUMENTS="public-court-documents"
STORAGE_BUCKET_PRIVATE_CASES="private-advocate-cases"
MAX_UPLOAD_SIZE_MB=25

# Admin Access Bootstrap (For establishing initial super-admin securely)
# Set a temporary one-time token in server env to claim admin status if DB is fresh
ADMIN_BOOTSTRAP_TOKEN="setup-alwar-admin-token-replace-immediately"
